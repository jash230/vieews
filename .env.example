# Copy to .env.local and fill in. In Vercel, add the same keys under Project → Settings → Environment Variables.

# Public URL of the app (no trailing slash). Used for OAuth redirect URIs and the MCP URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Supabase (Project settings → API keys). The secret key stays server-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts platform OAuth tokens at rest. Changing it disconnects every account.
TOKEN_ENCRYPTION_KEY=

# Inngest (app.inngest.com → your app → Keys). Not needed with the local dev server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# YouTube (Google Cloud → APIs & Services → Credentials → OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Instagram (developers.facebook.com → your app → Instagram → API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok (developers.tiktok.com → your app → Credentials)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Claude API for the copilot and project drafting (platform.claude.com → API keys). Billed per use.
ANTHROPIC_API_KEY=
